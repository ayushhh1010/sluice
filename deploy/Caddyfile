{
	email {$ACME_EMAIL:admin@{$DOMAIN}}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	handle /api/* {
		reverse_proxy agent-1:8080 agent-2:8080 {
			lb_policy round_robin
			lb_try_duration 5s
			health_uri /api/v1/cluster
			health_interval 10s
			flush_interval -1
		}
	}
	handle /grafana* {
		reverse_proxy grafana:3000
	}
	handle {
		root * /srv/playground
		try_files {path} /index.html
		file_server
	}
}

# Caddy obtains (and renews) the certificates the agents' Kafka TLS
# listeners use; the agents read them from the shared volume. Kafka itself
# does not go through Caddy: DNS for k1/k2 must be DNS-only, not proxied.
k1.{$DOMAIN}, k2.{$DOMAIN} {
	respond "Sluice Kafka endpoint: use port 9093 (k1) or 9094 (k2) with SASL_SSL." 200
}
