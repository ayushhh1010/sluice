   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, op) (rate(sluice_objstore_latency_seconds_bucket[5m])))",
     "legendFormat": "{{op}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Metadata append latency (p50 / p99)",
   "gridPos": {
    "x": 12,
