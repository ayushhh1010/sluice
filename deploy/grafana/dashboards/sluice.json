    {
     "expr": "sum(rate(sluice_objstore_requests_total{class=\"B\"}[5m]))",
     "legendFormat": "Class B (GET, HEAD)",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Object store latency p99 by op",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
