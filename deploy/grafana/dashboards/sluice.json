    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum by (api) (rate(sluice_kafka_requests_total[5m]))",
     "legendFormat": "{{api}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Connections and throttling",
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
