# Copy to .env (never commit .env). Values are read by every Sluice process.
DOMAIN=sluice.example.com
# Let's Encrypt account email for the certificates Caddy obtains.
ACME_EMAIL=you@example.com
SLUICE_IMAGE=ghcr.io/ayushhh1010/sluice:latest

# Object store: an R2 token scoped to one bucket.
SLUICE_STORE=s3://sluice-prod?endpoint=https://<account-id>.r2.cloudflarestorage.com&region=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SLUICE_CLUSTER=prod
SLUICE_LOG_LEVEL=info

# Agents connect to both sequencers; only the active one answers.
SLUICE_SEQUENCERS=seq-a=sequencer-a:7000,seq-b=sequencer-b:7000

# Public listener credentials: "demo" is published, "admin" is not.
SLUICE_SASL_USERS=demo:sluice-demo,admin:change-me
SLUICE_ADMIN_USERS=admin

# Class A operations per UTC day before public listeners turn read-only
# (30,000/day keeps the demo inside R2's free tier).
COST_GUARD_DAILY=30000
GRAFANA_ADMIN_PASSWORD=change-me
